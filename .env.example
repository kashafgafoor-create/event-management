# Copy this file to .env for local development.
APP_NAME=Corporate Event Management
APP_VERSION=1.0.0
APP_ENV=development

# Local SQLite default. For hosted PostgreSQL use:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=sqlite:///./corporate_events.db

# Generate a unique secret for every real deployment (at least 32 characters).
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# For local development, allow the same-origin browser UI.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=*
AUTO_CREATE_TABLES=true
